<?xml version="1.0" encoding="utf-8"?>
<!-- Simple SVG placeholder saved with .jpg extension so browsers will still display when used as img src -->
<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="800" viewBox="0 0 1200 800">
  <rect width="100%" height="100%" fill="#f3f4f6"/>
  <g fill="#e5e7eb" font-family="Arial, Helvetica, sans-serif" font-size="48">
    <text x="50%" y="45%" dominant-baseline="middle" text-anchor="middle" fill="#c7c9cc">No Image</text>
    <text x="50%" y="58%" dominant-baseline="middle" text-anchor="middle" fill="#9ca3af" font-size="28">news placeholder</text>
  </g>
</svg>
